@model VesselSchedule
@{
    var tugs = (List<string>)ViewBag.AssignedTugboats;
}
<div class="schedule-confirm-review">
    <dl id="bookingReview">
        <dt>Customer</dt><dd>@(Model.Customer?.CustomerName ?? "Not selected")</dd>
        <dt>Vessel</dt><dd>@Model.Vessel.VesselName</dd>
        <dt>Location</dt><dd>@Model.Port.PortName / @Model.Terminal.TerminalName</dd>
        <dt>Voyage</dt><dd>@(Model.VoyageNumber ?? "—")</dd>
        <dt>Planned start / Job Order date</dt><dd>@Model.PlannedStart.ToString("MMM d, yyyy · HH:mm")</dd>
        <dt>Planned end</dt><dd>@Model.PlannedEnd.ToString("MMM d, yyyy · HH:mm")</dd>
        <dt>Assigned tugs</dt><dd>@(tugs.Count == 0 ? "Not assigned" : string.Join(", ", tugs))</dd>
    </dl>
    <p>Confirmation creates a Job Order using these booking details. All times are Philippine time.</p>
    <form asp-action="Confirm" asp-controller="VesselSchedule" asp-area="MSAP" method="post" id="confirmSchedule">
        <input type="hidden" name="id" value="@Model.VesselScheduleId" />
        <input type="hidden" name="reviewedAt" value="@((Model.EditedDate ?? Model.CreatedDate).ToString("O"))" />
        <input type="hidden" name="allowConflicts" value="false" />
    </form>
</div>
